# Copy to .env and adjust. docker compose reads it automatically.
MYSQL_ROOT_PASSWORD=root-change-me
MYSQL_PASSWORD=hungrybox
JWT_SECRET=dev-only-secret-change-me-before-deploying-0123456789abcdef
ADMIN_EMAIL=admin@hungrybox.dev
ADMIN_PASSWORD=Admin@12345
# Orders above this amount are declined by the mock payment gateway (handy for demos).
MAX_TRANSACTION_AMOUNT=5000
